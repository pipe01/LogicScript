const size = 8

input'size a
input'size b
input'3 op
output'(size + 1) out

const op_add = 1
const op_sub = 2
const op_mul = 3
const op_div = 4

when *
    out = 0

    for $i to 20
        @print $i
    end
end

when op == op_add
    out = a + b
end

when op == op_sub
    out = a - b
end

when op == op_mul
    out '= a * b
end

when op == op_div
    out = a / b
end

@test "Addition" (
    a(1) b(1) => out(0),
    op(op_add) => out(2),

    op(0) => out(0),

    a(255) b(255) => out(0),
    op(op_add) => out(510),
)

@test "Subtraction" (
    a(1) b(1) => out(0),
    op(op_sub) => out(0),

    op(0) => out(0),

    a(255) b(255) => out(0),
    op(op_sub) => out(0),
)

@test "Multiplication" (
    a(1) b(1) => out(0),
    op(op_mul) => out(1),

    op(0) => out(0),

    a(14) b(25) => out(0),
    op(op_mul) => out(350),
)

@test "Division" (
    a(1) b(1) => out(0),
    op(op_div) => out(1),

    op(0) => out(0),

    a(40) b(2) => out(0),
    op(op_div) => out(20),
)
